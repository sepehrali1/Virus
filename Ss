local function clampToScreen(tl, size)
	refreshViewport()
	local top = topInset()
	return Vector2.new(
		math.clamp(tl.X, 0, math.max(0, viewport.X - size.X)),
		math.clamp(tl.Y, top, math.max(top, viewport.Y - size.Y))
	)
end
local function placeTopLeft(target, tl)
	local a, sz = target.AnchorPoint, target.AbsoluteSize
	target.Position = UDim2.fromOffset(tl.X + a.X * sz.X, tl.Y + a.Y * sz.Y)
end

local function makeDraggable(handle, target, onClick)
	local dragging = false
	local moved = false
	local startPos = Vector2.new()
	local startTL = Vector2.new()
	local goal = Vector2.new()
	local cur = Vector2.new()
	local renderConn = nil

	table.insert(Cleanups, function()
		if renderConn then renderConn:Disconnect() end
	end)

	handle.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		dragging = true
		moved = false
		startPos = input.Position
		startTL = target.AbsolutePosition
		goal = startTL
		cur = startTL

		if not renderConn then
			renderConn = RunService.RenderStepped:Connect(function(dt)
				if not target or not target.Parent then return end
				local dist = (cur - goal).Magnitude
				if dragging or dist > 0.5 then
					cur = cur:Lerp(goal, math.min(1, dt * 20))
					placeTopLeft(target, clampToScreen(cur, target.AbsoluteSize))
					if not dragging and dist < 0.5 then
						placeTopLeft(target, clampToScreen(goal, target.AbsoluteSize))
						renderConn:Disconnect()
						renderConn = nil
					end
				end
			end)
		end
	end)

	bind(UIS.InputChanged, function(input)
		if not dragging or not isMove(input) then return end
		local delta = input.Position - startPos
		if delta.Magnitude > 6 then moved = true end
		if moved then
			goal = clampToScreen(startTL + Vector2.new(delta.X, delta.Y), target.AbsoluteSize)
		end
	end)

	bind(UIS.InputEnded, function(input)
		if not isPress(input) then return end
		if not dragging then return end
		dragging = false
		if not moved and onClick then onClick() end
	end)
end
