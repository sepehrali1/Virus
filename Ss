		if not resizing or not isMove(input) then return end
		refreshViewport()
		local d = input.Position - rStart
		local availW = math.max(MIN_W, math.min(MAX_W, viewport.X - rStartTL.X))
		local availH = math.max(MIN_H, math.min(MAX_H, viewport.Y - rStartTL.Y))
		panelW = math.clamp(rStartSize.X + d.X, math.min(MIN_W, availW), availW)
		panelH = math.clamp(rStartSize.Y + d.Y, math.min(MIN_H, availH), availH)
		Main.Size = UDim2.fromOffset(panelW, panelH)
		placeTopLeft(Main, rStartTL)
	end)

	bind(UIS.InputEnded, function(input)
		if isPress(input) then resizing = false end
	end)
