local function runEntry(e)
	SetStatus("executing " .. e.name .. "...", "warn")
	task.spawn(function()
		local ok, err = pcall(e.callback)
		if ok then
			SetStatus(e.name .. " complete", "ok")
			VT_Notify(e.name, "executed successfully", "ok")
		else
			SetStatus("error in " .. e.name, "err")
			VT_Notify("error", tostring(err):sub(1, 60), "err", 4)
		end
	end)
end

local function buildCard(e, index)
	local card = new("CanvasGroup", {Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = VOID, BackgroundTransparency = 0.3, BorderSizePixel = 0, LayoutOrder = index, ZIndex = 12}, ListScroll)
	corner(card, 4)
	local cs = stroke(card, CYAN, 1, 0.65)
	local scale = new("UIScale", {}, card)

	new("TextLabel", {
		Size = UDim2.new(1, -100, 0, 18), Position = UDim2.new(0, 12, 0, 7), BackgroundTransparency = 1,
		Text = "> " .. e.name, Font = Enum.Font.Code, TextSize = 13, TextColor3 = CYAN,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 13,
	}, card)
	new("TextLabel", {
		Size = UDim2.new(1, -100, 0, 14), Position = UDim2.new(0, 12, 0, 26), BackgroundTransparency = 1,
		Text = e.desc or "tap to execute", Font = Enum.Font.Code, TextSize = 10, TextColor3 = DIM,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 13,
	}, card)
	local tag = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 0, 0, 18),
		AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = VOID, BackgroundTransparency = 0.2,
		Text = "[" .. e.cat .. "]", Font = Enum.Font.Code, TextSize = 9, TextColor3 = MAGENT, ZIndex = 13,
	}, card)
	corner(tag, 3)
	stroke(tag, MAGENT, 1, 0.5)
	new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, tag)

	local flash = new("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = CYAN, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 14}, card)

	local hit = new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 20}, card)
	hit.MouseEnter:Connect(function() tween(card, TweenInfo.new(0.15), {BackgroundTransparency = 0.05}); tween(cs, TweenInfo.new(0.15), {Transparency = 0.1}) end)
	hit.MouseLeave:Connect(function() tween(card, TweenInfo.new(0.15), {BackgroundTransparency = 0.3}); tween(cs, TweenInfo.new(0.15), {Transparency = 0.65}) end)
	hit.InputBegan:Connect(function(i) if isPress(i) then tween(scale, TweenInfo.new(0.1), {Scale = 0.97}) end end)
	hit.InputEnded:Connect(function(i) if isPress(i) then tween(scale, TweenInfo.new(0.2, EASE2), {Scale = 1}) end end)
	hit.MouseButton1Click:Connect(function()
		flash.BackgroundTransparency = 0.6
		tween(flash, TweenInfo.new(0.4), {BackgroundTransparency = 1})
		runEntry(e)
	end)
	return card
end

local function refreshList()
	for _, c in ipairs(cards) do c:Destroy() end
	cards = {}
	local q = string.lower(SearchBox.Text)
	local n = 0
	for _, e in ipairs(entries) do
		local catOk = (currentCat == "ALL") or (e.cat == currentCat)
		local searchOk = (q == "") or string.find(string.lower(e.name), q, 1, true)
		if catOk and searchOk then
			n = n + 1
			local c = buildCard(e, n)
			fadeIn(c, math.min(n * 0.03, 0.3))
			table.insert(cards, c)
		end
	end
	EmptyLabel.Text = (n == 0) and ((#entries == 0) and "> NO MODULES LOADED" or "> NO MATCH FOUND") or ""
end

local function scheduleRefresh()
	if refreshQueued then return end
	refreshQueued = true
	task.defer(function() refreshQueued = false; if not destroyed then refreshList() end end)
end

local function styleChips()
	for cat, c in pairs(chipBtns) do
		local sel = (cat == currentCat)
		tween(c, TweenInfo.new(0.2), {BackgroundTransparency = sel and 0.1 or 0.3, TextColor3 = sel and CYAN or DIM})
	end
end

local function rebuildChips()
	for _, c in pairs(chipBtns) do c:Destroy() end
	chipBtns = {}
	local cats, seen = {"ALL"}, {ALL = true}
	for _, e in ipairs(entries) do
		if not seen[e.cat] then seen[e.cat] = true; table.insert(cats, e.cat) end
	end
	if not seen[currentCat] then currentCat = "ALL" end
	for i, cat in ipairs(cats) do
		local btn = new("TextButton", {
			AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, 24), BackgroundColor3 = VOID,
			BackgroundTransparency = 0.3, Text = cat, Font = Enum.Font.Code, TextSize = 11, TextColor3 = DIM,
			AutoButtonColor = false, LayoutOrder = i, ZIndex = 13,
		}, ChipsScroll)
		corner(btn, 3)
		stroke(btn, CYAN, 1, 0.6)
		new("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, btn)
		chipBtns[cat] = btn
		btn.MouseButton1Click:Connect(function() currentCat = cat; styleChips(); refreshList() end)
	end
	styleChips()
end
