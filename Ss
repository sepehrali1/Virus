	}, card)

	tween(card, TweenInfo.new(0.3, EASE2), {Position = UDim2.new(0, 0, 0, 0), GroupTransparency = 0})
	task.delay(duration, function()
		if not card.Parent then return end
		tween(card, TweenInfo.new(0.25, EASE), {Position = UDim2.new(0, 0, 0, -12), GroupTransparency = 1})
